# Required: MySQL container's root password on first boot. Used directly by
# the manual docker-mysql-up/docker-run targets; ignored by `make compose-up`,
# which reads the password from secrets/mysql_root_password.txt instead.
MYSQL_ROOT_PASSWORD=yourpassword

# Required: name of the database the mysql container creates on first boot.
MYSQL_DATABASE=student_db

# Required: MySQL connection string, resolved over the Docker network -
# `student-mysql` is the mysql container's name, resolvable only from other
# containers on the same network, not from your host machine. Used directly
# by the manual docker-run target; ignored by `make compose-up`, which reads
# the DSN from secrets/dsn.txt instead.
DSN=root:yourpassword@tcp(student-mysql:3306)/student_db?charset=utf8mb4&parseTime=True&loc=Local

# Optional: port the server listens on (default: 8888)
PORT=8888

# Optional: where the app writes its logs (in addition to stdout), on the
# student-logs volume mounted by docker-run - see main.go. Logs there
# survive `make docker-down`, since removing the container doesn't remove
# the volume.
LOG_FILE=/var/log/app/rest-api.log
