# Required: MySQL connection string. The host differs depending on how
# you're running the app - switch it when you switch modes:
#   - Running the app directly (`make run`/`go run .`) or against a locally
#     installed MySQL: 127.0.0.1, as below.
#   - Running via Docker (`make docker-run`/`docker-migrate`): use
#     `student-mysql` instead - that's the mysql container's name, resolvable
#     only from other containers on the same Docker network, not from your
#     host machine. See the Running with Docker section in the README.
DSN=root:yourpassword@tcp(127.0.0.1:3306)/student_db?charset=utf8mb4&parseTime=True&loc=Local

# Optional: port the server listens on (default: 8888)
PORT=8888

# Optional: Gin's runtime mode (debug/release/test) - see main.go.
GIN_MODE=release

# Required only for the Docker workflow - consumed by the mysql container
# itself (via docker-mysql-up), not by the app. Ignored when running the
# app directly.
MYSQL_ROOT_PASSWORD=yourpassword
MYSQL_DATABASE=student_db

# Optional, only meaningful for Compose (default: 3306). Host port that
# mysql's 3306 is published on - override this if something on your machine
# is already listening on 3306. Doesn't affect DSN: migrate/rest-api always
# reach mysql over the Docker network as student-mysql:3306, regardless of
# this value.
MYSQL_PORT=3306

# Optional, only meaningful for the Docker workflow - where the app writes
# its logs (in addition to stdout), on the student-logs volume mounted by
# docker-run/Compose - see main.go. Logs there survive `make docker-down` /
# `make compose-down`, since removing a container doesn't remove the volume.
LOG_FILE=/var/log/app/rest-api.log

# Optional, only meaningful for the Docker workflow - where cmd/migrate
# writes its logs (in addition to stdout), on the student-migrate-logs
# volume mounted by docker-migrate/Compose - see cmd/migrate/main.go. Logs
# there survive the migrate container being removed (it always is - either
# by --rm or because it's a one-shot Compose service).
MIGRATE_LOG_FILE=/var/log/app/migrate.log
